{
  "name": "fenix-tv-panel",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",

compatibility_flags = ["global_fetch_strictly_public"]
keep_vars = true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fenix-tv-cms",
      "database_id": "f862d1ea-05e1-4006-ba01-72879b5f2a8b"
    }
  ],
  "vars": {
    "INITIAL_CHANNELS_URL": "https://raw.githubusercontent.com/ELMANIU/hbo-family-worker/refs/heads/main/channels.json"
  }
}
